{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VOID",
  "version": "0.1.0",
  "identifier": "in.beyondigital.void",
  "build": {
    "beforeDevCommand": "pnpm --filter void-tauri exec vite",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "pnpm --filter void-tauri exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VOID Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
