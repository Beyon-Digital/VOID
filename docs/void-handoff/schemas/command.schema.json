        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "clipId": {
                "type": "string",
                "format": "uuid"
              },
              "trackId": {
                "type": "string",
                "format": "uuid"
              },
              "assetSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "startTick": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)$"
              },
              "durationTicks": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            },
            "required": [
              "clipId",
              "trackId",
              "assetSha256",
              "startTick",
              "durationTicks"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "clip.move"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "clipId": {
                "type": "string",
                "format": "uuid"
              },
              "trackId": {
                "type": "string",
                "format": "uuid"
              },
              "startTick": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)$"
              }
            },
            "required": [
              "clipId",
              "trackId",
              "startTick"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "clip.trim"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "clipId": {
                "type": "string",
                "format": "uuid"
              },
              "sourceOffsetSamples": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "durationTicks": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            },
            "required": [
              "clipId",
              "sourceOffsetSamples",
              "durationTicks"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "notes.insert"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "trackId": {
                "type": "string",
                "format": "uuid"
              },
              "clipId": {
                "type": "string",
                "format": "uuid"
              },
              "notes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2000,
                "items": {
                  "type": "object",
                  "properties": {
                    "noteId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "startTick": {
                      "type": "string",
                      "pattern": "^-?(0|[1-9][0-9]*)$"
                    },
                    "durationTicks": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    },
                    "pitch": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 127
                    },
                    "velocity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "noteId",
                    "startTick",
                    "durationTicks",
                    "pitch",
                    "velocity"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "trackId",
              "clipId",
              "notes"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "parameter.set"
          }
