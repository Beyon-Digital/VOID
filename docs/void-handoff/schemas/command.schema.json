{
  "type": "object",
  "properties": {
    "protocolMajor": {
      "const": 1
    },
    "protocolMinor": {
      "type": "integer",
      "minimum": 0
    },
    "commandId": {
      "type": "string",
      "format": "uuid"
    },
    "transactionId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "engineEpoch": {
      "type": "string",
      "format": "uuid"
    },
    "expectedRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "operation": {
      "enum": [
        "project.create",
        "track.create",
        "clip.place",
        "clip.move",
        "clip.trim",
        "notes.insert",
        "parameter.set",
        "history.undo",
        "history.redo",
        "proposal.accept"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "protocolMajor",
    "protocolMinor",
    "commandId",
    "transactionId",
    "projectId",
    "engineEpoch",
    "expectedRevision",
    "operation",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://void.invalid/schemas/command/1.0.0",
  "title": "VOID initial persistent-mutation DTO",
  "description": "Semantic JSON boundary only. Int64 range, finite values, capability, parameter bounds and native binary verifier are mandatory runtime validations. .invalid ID is an identifier, not a hosted service.",
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "project.create"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sampleRate": {
                "type": "integer",
                "minimum": 8000,
                "maximum": 384000
              }
            },
            "required": [
              "name",
              "sampleRate"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "track.create"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "trackId": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "enum": [
                  "audio",
                  "midi",
                  "instrument",
                  "bus"
                ]
              }
            },
            "required": [
              "trackId",
              "name",
              "kind"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
