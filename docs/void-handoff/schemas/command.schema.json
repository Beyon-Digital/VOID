                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "targetTransactionId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "proposal.accept"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "proposalId": {
                "type": "string",
                "format": "uuid"
              },
              "contextSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "selectedItemIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2000,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "format": "uuid"
